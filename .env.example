# ==============================================================================
# AMS ENTERPRISE VISITOR MANAGEMENT SYSTEM (VMS)
# ENVIRONMENT CONFIGURATION & DATABASE CONNECTION STRINGS
# ==============================================================================

# Server Port
PORT=5000

# Primary SQL Server 2014 / 2016 / 2019 / 2022 Connection String
# Format 1: Standard SQL Authentication
SQLSERVER_CONNECTION_STRING="Server=localhost;Database=vms_of_ams;User Id=sa;Password=YourPassword123;TrustServerCertificate=True;Encrypt=False;"

# Format 2: Named Instance / Non-standard port
# SQLSERVER_CONNECTION_STRING="Server=127.0.0.1,1433;Database=vms_of_ams;User Id=sa;Password=YourPassword123;TrustServerCertificate=True;Encrypt=False;"

# Format 3: Windows Authentication / Integrated Security
# SQLSERVER_CONNECTION_STRING="Server=localhost;Database=vms_of_ams;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;"

# Alternatively: Granular connection parameters
MSSQL_SERVER="localhost"
MSSQL_PORT=1433
MSSQL_DATABASE="vms_of_ams"
MSSQL_USER="sa"
MSSQL_PASSWORD=""
