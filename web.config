<?xml version="1.0" encoding="utf-8"?>
<!--
  ======================================================================
  AMS Enterprise Visitor Management System (VMS)
  IIS / Windows Server Web Configuration File (web.config)
  Target Environment: Windows Server IIS / Azure App Service (iisnode)
  ======================================================================
-->
<configuration>
  <!-- 
    ===========================================================================
    DATABASE CONNECTION STRING CONFIGURATION
    Configure your Microsoft SQL Server connection string here or in IIS Manager.
    Works with SQL Server 2014, 2016, 2019, 2022, and Azure SQL.
    ===========================================================================
  -->
  <connectionStrings>
    <add name="VmsDatabase" 
         connectionString="Server=localhost;Database=vms_of_ams;User Id=sa;Password=;TrustServerCertificate=True;Encrypt=False;" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.webServer>
    
    <!-- 1. iisnode Handler: Directs requests to Node.js backend (server.js) -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- 2. URL Rewrite Rules -->
    <rewrite>
      <rules>
        <!-- Disallow direct browsing to node_modules and internal directories -->
        <rule name="ProtectFiles" stopProcessing="true">
          <match url="^(\.git|node_modules|bin)/" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access is denied." />
        </rule>

        <!-- Static assets from dist/ folder -->
        <rule name="StaticContentAssets" stopProcessing="true">
          <match url="^assets/(.*)" />
          <action type="Rewrite" url="dist/assets/{R:1}" />
        </rule>

        <rule name="StaticContent" stopProcessing="true">
          <match url="^dist/(.*)" />
          <action type="Rewrite" url="dist/{R:1}" />
        </rule>

        <!-- Route all application traffic to server.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- 3. Security Settings -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".git" />
          <add segment="bin" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="52428800" /> <!-- 50MB max upload -->
      </requestFiltering>
    </security>

    <!-- 4. HTTP Compression & Performance -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- 5. Custom MIME Types for Modern Frontend Assets -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <!-- 6. Custom HTTP Headers for Security -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- 7. iisnode Configuration -->
    <iisnode
      nodeProcessCommandLine="node.exe"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      asyncCompletionThreadCount="0"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      watchedFiles="*.js;Database_MySQL_SQL\*"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="false"
    />

  </system.webServer>
</configuration>
